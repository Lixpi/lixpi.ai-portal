{
    "compilerOptions": {
        "rootDirs": [
            "./src"
        ],
        "isolatedModules": true,
        "lib": [
            "esnext",
            "DOM",
            "DOM.Iterable"
        ],
        "noEmit": true,
        "target": "esnext",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true,
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "paths": {
            "$src": ["./src"],
            "$src/*": ["./src/*"]
        }
    },
    "include": [
        "./vite.config.ts",
        "./vitest.config.ts",
        "./src/**/*.ts"
    ],
    "exclude": [
        "./node_modules/**"
    ]
}
